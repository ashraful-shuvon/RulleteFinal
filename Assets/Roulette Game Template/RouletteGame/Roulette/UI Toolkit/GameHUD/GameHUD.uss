/*
 * Roulette Game HUD Styles
 * Elite Casino Game: Roulette - In-Game Multiplayer UI (Mobile Scaled)
 */

/* ============================================
   GAME HUD CONTAINER
   ============================================ */

.game-hud {
    width: 100%;
    height: 100%;
    position: absolute;
}

/* ============================================
   TOP BAR
   ============================================ */

.top-bar {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    padding: 30px 60px 20px 120px; /* Big 120px left margin for landscape notch */
    background-color: rgba(0, 0, 0, 0.7);
    border-bottom-width: 1px;
    border-bottom-color: rgba(212, 175, 55, 0.3);
}

.phase-container {
    align-items: flex-start;
}

.phase-label {
    color: rgb(212, 175, 55);
    font-size: 36px;
    -unity-font-style: bold;
    white-space: nowrap;
}

.phase-timer-row {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}

.phase-timer-bar {
    flex-direction: row;
    align-items: center;
    height: 40px;
    width: 200px;
    background-color: rgba(50, 50, 50, 1);
    border-radius: 20px;
    overflow: hidden;
}

.timer-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(212, 175, 55);
    border-radius: 30px;
}

.timer-label {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    color: white;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ============================================
   CONNECTION INFO
   ============================================ */

.connection-info {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 10px;
}

.connection-dot {
    color: rgb(100, 255, 100);
    font-size: 40px;
    margin-right: 12px;
}

.connection-dot.disconnected {
    color: rgb(255, 100, 100);
}

.players-label {
    color: rgba(255, 255, 255, 0.8);
    font-size: 26px;
}

/* ============================================
   RIGHT PANEL (Players)
   ============================================ */

.right-panel {
    position: absolute;
    right: 35px;
    top: 135px;
    width: 250px;
    padding: 15px;
    background-color: rgba(15, 15, 20, 0.85);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.panel-title {
    color: rgba(255, 255, 255, 0.5);
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.players-hud-list {
    height: 220px;
}

.invite-hud-btn {
    height: 50px;
    margin-top: 10px;
    background-color: rgba(212, 175, 55, 0.6);
    border-radius: 12px;
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-font-style: bold;
}

.invite-hud-btn:hover {
    background-color: rgba(212, 175, 55, 0.9);
}

/* ============================================
   BOTTOM BAR
   ============================================ */

.bottom-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    flex-direction: column;
    justify-content: flex-end;
    align-items: stretch;
    padding: 20px 50px 30px 50px; /* Crucial hardware curve safety padding */
    background-color: rgba(0, 0, 0, 0.85);
}

.bottom-bar-top-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 12px;
}

/* ============================================
   BALANCE SECTION
   ============================================ */

.balance-section {
    flex-direction: column;
}

.balance-label-small {
    color: rgba(255, 255, 255, 0.6);
    font-size: 18px;
    margin-bottom: 2px;
}

.balance-text {
    color: rgb(212, 175, 55);
    font-size: 38px;
    -unity-font-style: bold;
}

.total-bet-text {
    color: rgba(255, 255, 255, 0.8);
    font-size: 20px;
    margin-top: 4px;
}

/* ============================================
   ACTION BUTTONS
   ============================================ */

.action-buttons {
    flex-direction: row;
    width: 100%;
}

.action-btn {
    flex-grow: 1;
    height: 70px;
    margin: 0 4px;
    border-radius: 12px;
    font-size: 18px; /* Slightly smaller to fit the massive padding constraints gracefully */
    -unity-font-style: bold;
}

.clear-btn {
    background-color: rgba(200, 80, 80, 0.5);
    color: rgb(255, 150, 150);
}

.clear-btn:hover {
    background-color: rgba(200, 80, 80, 0.8);
}

.undo-btn {
    background-color: rgba(150, 150, 200, 0.5);
    color: rgb(200, 200, 255);
}

.undo-btn:hover {
    background-color: rgba(150, 150, 200, 0.8);
}

.rebet-btn {
    background-color: rgba(80, 180, 80, 0.5);
    color: rgb(150, 255, 150);
}

.rebet-btn:hover {
    background-color: rgba(80, 180, 80, 0.8);
}

.double-btn {
    background-color: rgba(212, 175, 55, 0.5);
    color: rgb(255, 215, 100);
}

.double-btn:hover {
    background-color: rgba(212, 175, 55, 0.8);
}

/* ============================================
   ROOM CODE HUD
   ============================================ */

.room-code-hud {
    flex-direction: row;
    align-items: center;
}

.room-code-hud-text {
    color: rgba(255, 255, 255, 0.6);
    font-size: 16px;
}

.copy-code-btn {
    width: 40px;
    height: 40px;
    margin-left: 10px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    font-size: 18px;
    color: white;
}

/* ============================================
   PLAYER HUD ENTRY
   ============================================ */

.player-hud-entry {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    margin-bottom: 2px;
    background-color: transparent;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
    border-radius: 0;
    min-height: 55px;
}

.avatar-box {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: rgba(212, 175, 55, 0.3);
    margin-right: 10px;
    position: relative;
}

.player-avatar {
    width: 100%;
    height: 100%;
    border-radius: 18px;
}

.info-box {
    flex-grow: 1;
    justify-content: center;
    overflow: hidden;
    margin-left: 5px;
}

.master-crown {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 18px;
    height: 18px;
    background-color: rgb(212, 175, 55);
    border-radius: 9px;
    display: none;
}

.player-hud-entry.is-master .master-crown {
    display: flex;
}

.info-box {
    flex-grow: 1;
}

.hud-name {
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin: 0;
    padding: 0;
}

.hud-balance {
    color: rgb(212, 175, 55);
    font-size: 13px;
    margin: 0;
    padding: 0;
    margin-top: 2px;
}

.bet-indicator {
    padding: 4px 8px;
    background-color: rgba(80, 180, 80, 0.4);
    border-radius: 6px;
    margin-right: 6px;
    justify-content: center;
    align-items: center;
}

.hud-bet {
    color: rgb(150, 255, 150);
    font-size: 14px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.bet-indicator.no-bet {
    background-color: rgba(100, 100, 100, 0.4);
}

.bet-indicator.no-bet .hud-bet {
    color: rgba(255, 255, 255, 0.5);
}

.ready-dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: rgb(100, 255, 100);
}

.ready-dot.not-ready {
    background-color: rgba(255, 255, 255, 0.3);
}

/* ============================================
   RESULT POPUP
   ============================================ */

.result-popup {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.75);
    justify-content: center;
    align-items: center;
}

.result-card {
    width: 85%;
    max-width: 500px;
    padding: 50px;
    background-color: rgba(30, 30, 40, 0.98);
    border-radius: 24px;
    border-width: 4px;
    border-color: rgb(212, 175, 55);
    align-items: center;
}

.result-number {
    font-size: 100px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: 20px;
}

.result-color {
    width: 100%;
    height: 12px;
    border-radius: 6px;
    margin-bottom: 30px;
}

.result-color.red {
    background-color: rgb(200, 50, 50);
}

.result-color.black {
    background-color: rgb(50, 50, 50);
}

.result-color.green {
    background-color: rgb(50, 150, 50);
}

.result-win-label {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(212, 175, 55);
    margin-bottom: 16px;
}

.win-amount-label {
    font-size: 40px;
    color: rgb(100, 255, 100);
}

/* ============================================
   INVITE PANEL
   ============================================ */

.invite-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    justify-content: center;
    align-items: center;
}

.invite-card {
    width: 85%;
    max-width: 500px;
    padding: 40px;
    background-color: rgba(30, 30, 40, 0.98);
    border-radius: 20px;
    border-width: 4px;
    border-color: rgb(212, 175, 55);
    align-items: center;
}

.invite-title {
    color: rgb(212, 175, 55);
    font-size: 36px;
    -unity-font-style: bold;
    margin-bottom: 30px;
}

.menu-divider-text {
    color: rgba(255, 255, 255, 0.4);
    font-size: 20px;
    margin: 15px 0;
    -unity-font-style: bold;
}

.join-code-input {
    width: 100%;
    margin-bottom: 20px;
    background-color: rgba(50, 50, 60, 0.8);
    color: white;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 12px;
    height: 80px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.2);
}

.join-friends-btn {
    width: 100%;
    height: 80px;
    margin-bottom: 20px;
    background-color: rgba(100, 255, 100, 0.8);
    border-radius: 12px;
    color: rgb(20, 40, 20);
    font-size: 28px;
    -unity-font-style: bold;
}

.join-friends-btn:hover {
    background-color: rgb(120, 255, 120);
}

.invite-code-label {
    color: rgba(255, 255, 255, 0.7);
    font-size: 24px;
    margin-bottom: 12px;
}

.invite-room-code {
    color: white;
    font-size: 60px;
    -unity-font-style: bold;
    letter-spacing: 12px;
    margin-bottom: 30px;
}

.copy-invite-btn {
    width: 100%;
    height: 80px;
    margin-bottom: 20px;
    background-color: rgb(212, 175, 55);
    border-radius: 12px;
    color: rgb(30, 30, 40);
    font-size: 28px;
    -unity-font-style: bold;
}

.copy-invite-btn:hover {
    background-color: rgb(232, 195, 75);
}

.close-invite-btn {
    width: 100%;
    height: 70px;
    background-color: transparent;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
    border-radius: 12px;
    color: rgba(255, 255, 255, 0.9);
    font-size: 24px;
}

.close-invite-btn:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

/* ============================================
   SETTINGS
   ============================================ */
.settings-panel {
    flex-direction: row;
    align-items: center;
    margin-left: 15px;
}

.setting-btn {
    width: 50px;
    height: 50px;
    border-radius: 25px;
    margin: 0 10px;
    background-color: rgba(0, 0, 0, 0.6);
    color: white;
    font-size: 24px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
}

.setting-btn.muted {
    color: gray;
    background-color: rgba(0, 0, 0, 0.8);
    opacity: 0.5;
}

/* ============================================
   CHIP SELECTOR
   ============================================ */
.chip-selector {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 15px;
}

.chip-btn {
    width: 60px;
    height: 60px;
    border-radius: 30px;
    margin: 0 4px;
    font-size: 22px;
    -unity-font-style: bold;
    background-color: rgba(50, 50, 60, 0.8);
    color: white;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
}

.chip-btn:hover {
    background-color: rgba(80, 80, 90, 0.9);
}

.chip-btn.selected-chip {
    border-color: rgb(212, 175, 55);
    background-color: rgba(212, 175, 55, 0.3);
    scale: 1.1;
}

/* ============================================
   STORE PANEL
   ============================================ */
.store-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.90);
    justify-content: center;
    align-items: center;
}

.store-card {
    width: 90%;
    max-width: 600px;
    max-height: 80%;
    padding: 30px;
    background-color: rgba(30, 30, 40, 0.95);
    border-radius: 20px;
    border-width: 4px;
    border-color: rgb(212, 175, 55);
    flex-direction: column;
}

.store-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.store-title {
    color: rgb(212, 175, 55);
    font-size: 36px;
    -unity-font-style: bold;
}

.close-store-btn {
    width: 60px;
    height: 60px;
    font-size: 30px;
    background-color: transparent;
    border-width: 0;
    color: rgba(255, 255, 255, 0.6);
}

.close-store-btn:hover {
    color: white;
}

.store-scroll-view {
    flex-grow: 1;
    margin-bottom: 20px;
}

.restore-purchases-btn {
    height: 50px;
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 20px;
}

.restore-purchases-btn:hover {
    color: white;
    border-color: white;
}

/* STORE ITEMS */
.store-item {
    flex-direction: row;
    align-items: center;
    background-color: rgba(50, 50, 60, 0.8);
    border-radius: 12px;
    padding: 15px;
    margin-bottom: 12px;
}

.store-item-icon {
    width: 80px;
    height: 80px;
    border-radius: 12px;
    background-color: rgba(212, 175, 55, 0.2);
    margin-right: 20px;
}

.store-item-info {
    flex-grow: 1;
    justify-content: center;
}

.store-item-name {
    color: white;
    font-size: 32px;
    -unity-font-style: bold;
}

.store-buy-btn {
    width: 130px;
    height: 70px;
    background-color: rgb(212, 175, 55);
    border-radius: 12px;
    color: rgb(30, 30, 40);
    font-size: 28px;
    -unity-font-style: bold;
}

.store-buy-btn:hover {
    background-color: rgb(232, 195, 75);
}
