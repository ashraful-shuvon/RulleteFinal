/*
 * Roulette Theme - Shared Styles
 * Elite Casino Game: Roulette - Common UI Styles
 */

/* ============================================
   CSS VARIABLES (Theme Colors)
   ============================================ */

:root {
    --gold-primary: rgb(212, 175, 55);
    --gold-light: rgb(232, 195, 75);
    --gold-dark: rgb(180, 140, 40);
    
    --bg-dark: rgb(20, 20, 30);
    --bg-card: rgba(40, 40, 50, 0.8);
    --bg-input: rgba(60, 60, 70, 1);
    
    --text-primary: rgb(255, 255, 255);
    --text-secondary: rgba(255, 255, 255, 0.7);
    --text-muted: rgba(255, 255, 255, 0.5);
    
    --success: rgb(100, 255, 100);
    --warning: rgb(255, 200, 100);
    --danger: rgb(255, 100, 100);
    
    --border-radius: 8px;
    --border-radius-sm: 4px;
    --border-radius-lg: 12px;
}

/* ============================================
   BASE ELEMENTS
   ============================================ */

Label {
    color: var(--text-primary);
    font-size: 36px;
    -unity-font: ref "Inter";
}

Button {
    -unity-font: ref "Inter";
    font-size: 32px;
    border-radius: 12px;
    transition-duration: 0.1s;
}

TextField {
    -unity-font: ref "Inter";
    font-size: 32px;
    background-color: var(--bg-input);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.1);
    color: var(--text-primary);
    padding: 16px 20px;
}

TextField:focus {
    border-color: var(--gold-primary);
}

IntegerField {
    -unity-font: ref "Inter";
    font-size: 32px;
    background-color: var(--bg-input);
    border-radius: var(--border-radius-sm);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    color: var(--text-primary);
    padding: 8px 12px;
}

/* ============================================
   UTILITY CLASSES
   ============================================ */

.hidden {
    display: none;
}

.gold-text {
    color: var(--gold-primary);
}

.success-text {
    color: var(--success);
}

.danger-text {
    color: var(--danger);
}

.muted-text {
    color: var(--text-muted);
}

.bold {
    -unity-font-style: bold;
}

.centered {
    -unity-text-align: middle-center;
}

.right-aligned {
    -unity-text-align: middle-right;
}

/* ============================================
   CARDS
   ============================================ */

.card {
    background-color: var(--bg-card);
    border-radius: var(--border-radius);
    padding: 15px;
    margin: 5px 0;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.card-gold {
    border-color: var(--gold-primary);
}

/* ============================================
   BUTTONS
   ============================================ */

.btn {
    height: 80px;
    padding: 0 24px;
    border-radius: 12px;
}

.btn-primary {
    background-color: var(--gold-primary);
    color: var(--bg-dark);
    -unity-font-style: bold;
}

.btn-primary:hover {
    background-color: var(--gold-light);
}

.btn-secondary {
    background-color: rgba(100, 100, 150, 0.3);
    color: var(--text-primary);
}

.btn-secondary:hover {
    background-color: rgba(100, 100, 150, 0.5);
}

.btn-success {
    background-color: rgba(80, 180, 80, 0.4);
    color: var(--success);
}

.btn-success:hover {
    background-color: rgba(80, 180, 80, 0.6);
}

.btn-danger {
    background-color: rgba(200, 80, 80, 0.4);
    color: var(--danger);
}

.btn-danger:hover {
    background-color: rgba(200, 80, 80, 0.6);
}

.btn-small {
    height: 50px;
    font-size: 24px;
    padding: 0 16px;
}

.btn-large {
    height: 100px;
    font-size: 40px;
    padding: 0 32px;
}

.btn-wide {
    width: 100%;
}

/* ============================================
   INPUTS
   ============================================ */

.input-field {
    height: 80px;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 8px;
    border-width: 4px;
    border-color: rgba(212, 175, 55, 0.5);
    color: var(--text-primary);
    font-size: 32px;
    padding: 12px 20px;
}

.input-field:focus {
    border-color: var(--gold-primary);
}

.input-code {
    height: 100px;
    font-size: 52px;
    -unity-text-align: middle-center;
    letter-spacing: 4px;
    -unity-font-style: bold;
}

/* ============================================
   BADGES
   ============================================ */

.badge {
    padding: 6px 12px;
    border-radius: var(--border-radius-sm);
    font-size: 16px;
    -unity-font-style: bold;
}

.badge-gold {
    background-color: rgba(212, 175, 55, 0.2);
    color: var(--gold-primary);
}

.badge-success {
    background-color: rgba(100, 255, 100, 0.2);
    color: var(--success);
}

.badge-danger {
    background-color: rgba(255, 100, 100, 0.2);
    color: var(--danger);
}

/* ============================================
   SECTIONS
   ============================================ */

.section-header {
    color: var(--gold-primary);
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 20px;
    text-overflow: ellipsis;
}

/* ============================================
   DIVIDERS
   ============================================ */

.divider {
    height: 2px;
    background-color: rgba(255, 255, 255, 0.1);
    margin: 20px 0;
}

.divider-gold {
    background-color: rgba(212, 175, 55, 0.3);
}

/* ============================================
   SPACINGS
   ============================================ */

.mt-1 { margin-top: 4px; }
.mt-2 { margin-top: 8px; }
.mt-3 { margin-top: 12px; }
.mt-4 { margin-top: 16px; }
.mt-5 { margin-top: 20px; }

.mb-1 { margin-bottom: 4px; }
.mb-2 { margin-bottom: 8px; }
.mb-3 { margin-bottom: 12px; }
.mb-4 { margin-bottom: 16px; }
.mb-5 { margin-bottom: 20px; }

.p-1 { padding: 4px; }
.p-2 { padding: 8px; }
.p-3 { padding: 12px; }
.p-4 { padding: 16px; }
.p-5 { padding: 20px; }

/* ============================================
   FLEX UTILITIES
   ============================================ */

.flex-row { flex-direction: row; }
.flex-col { flex-direction: column; }
.flex-center { justify-content: center; align-items: center; }
.flex-between { justify-content: space-between; }
.flex-around { justify-content: space-around; }
.flex-grow { flex-grow: 1; }
.flex-wrap { flex-wrap: wrap; }

/* ============================================
   SCROLLVIEW
   ============================================ */

ScrollView {
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: var(--border-radius-sm);
}

ScrollView .unity-scroll-view__content-container {
    padding: 5px;
}

/* ============================================
   LIST VIEW
   ============================================ */

ListView {
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: var(--border-radius-sm);
}

ListView .unity-list-view__item {
    background-color: transparent;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
    padding: 8px;
}

ListView .unity-list-view__item:hover {
    background-color: rgba(212, 175, 55, 0.1);
}

ListView .unity-list-view__item:selected {
    background-color: rgba(212, 175, 55, 0.2);
}

/* Animations not natively supported in all USS versions, removing to prevent parser breaks */
