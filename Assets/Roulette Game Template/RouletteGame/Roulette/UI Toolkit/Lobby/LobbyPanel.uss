/*
 * Roulette Lobby Panel Styles
 * Elite Casino Game: Roulette - Multiplayer UI
 */

/* ============================================
   CONTAINER & LAYOUT
   ============================================ */

.lobby-container {
    width: 95%;
    height: 95%;
    background-color: rgba(20, 20, 30, 0.95);
    border-width: 2px;
    border-color: rgba(212, 175, 55, 0.5);
    border-radius: 12px;
    flex-direction: column;
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
}

/* ============================================
   HEADER
   ============================================ */

.lobby-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
    background-color: rgba(212, 175, 55, 0.1);
    border-bottom-width: 1px;
    border-bottom-color: rgba(212, 175, 55, 0.3);
}

.title-text {
    font-size: 50px;
    color: rgb(212, 175, 55);
    -unity-font-style: bold;
}

.close-btn {
    width: 60px;
    height: 60px;
    background-color: rgba(255, 80, 80, 0.2);
    border-radius: 30px;
    color: rgb(255, 100, 100);
    font-size: 32px;
}

.close-btn:hover {
    background-color: rgba(255, 80, 80, 0.4);
}

/* ============================================
   CONNECTION STATUS
   ============================================ */

.connection-status {
    flex-direction: row;
    justify-content: space-between;
    padding: 8px 20px;
    background-color: rgba(0, 0, 0, 0.3);
}

.status-connected {
    color: rgb(100, 255, 100);
    font-size: 12px;
}

.status-disconnected {
    color: rgb(255, 100, 100);
    font-size: 12px;
}

.ping-text {
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
}

/* ============================================
   CONTENT AREA
   ============================================ */

.content-area {
    flex-direction: column;
    flex-grow: 1;
    padding: 10px;
}

.room-info-section {
    width: 100%;
    padding-bottom: 10px;
}

.join-section {
    width: 100%;
}

/* ============================================
   CARDS
   ============================================ */

.current-room-card,
.players-list-card,
.join-by-code-card,
.quick-join-card,
.available-tables-card {
    background-color: rgba(40, 40, 50, 0.8);
    border-radius: 8px;
    padding: 15px;
    margin-bottom: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.section-label {
    color: rgb(212, 175, 55);
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

/* ============================================
   TABLE SETTINGS
   ============================================ */

.table-settings {
    margin-top: 10px;
}

.setting-label {
    color: rgba(255, 255, 255, 0.7);
    font-size: 26px;
    margin-top: 16px;
    margin-bottom: 8px;
}

.stakes-dropdown {
    height: 70px;
    background-color: rgba(60, 60, 70, 1);
    border-radius: 8px;
    color: rgb(255, 255, 255);
    font-size: 30px;
}

.bet-input {
    height: 70px;
    background-color: rgba(60, 60, 70, 1);
    border-radius: 8px;
    color: rgb(255, 255, 255);
    font-size: 30px;
}

/* ============================================
   ROOM CODE
   ============================================ */

.room-code-section {
    flex-direction: row;
    align-items: center;
    margin-top: 15px;
    padding: 10px;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 6px;
}

.room-code-label {
    color: rgba(255, 255, 255, 0.7);
    font-size: 12px;
    margin-right: 10px;
}

.room-code {
    color: rgb(212, 175, 55);
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 4px;
}

.copy-btn {
    width: 60px;
    height: 28px;
    margin-left: auto;
    background-color: rgba(100, 100, 150, 0.3);
    border-radius: 4px;
    color: rgb(255, 255, 255);
    font-size: 12px;
}

.copy-btn:hover {
    background-color: rgba(100, 100, 150, 0.5);
}

/* ============================================
   BUTTONS
   ============================================ */

.invite-buttons {
    flex-direction: row;
    margin-top: 15px;
}

.invite-btn {
    flex-grow: 1;
    height: 36px;
    margin-right: 10px;
}

.share-btn {
    width: 120px;
    height: 36px;
    background-color: rgba(80, 150, 255, 0.3);
    border-radius: 6px;
    color: rgb(150, 200, 255);
}

.share-btn:hover {
    background-color: rgba(80, 150, 255, 0.5);
}

.primary-btn {
    background-color: rgb(212, 175, 55);
    border-radius: 6px;
    color: rgb(20, 20, 30);
    font-size: 14px;
    -unity-font-style: bold;
}

.primary-btn:hover {
    background-color: rgb(232, 195, 75);
}

.secondary-btn {
    background-color: rgba(100, 100, 150, 0.3);
    border-radius: 6px;
    color: rgb(200, 200, 220);
}

.secondary-btn:hover {
    background-color: rgba(100, 100, 150, 0.5);
}

/* ============================================
   PLAYERS LIST
   ============================================ */

.players-list-view {
    height: 150px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
}

.player-count {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 10px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.1);
}

.player-count-text {
    color: rgba(255, 255, 255, 0.7);
    font-size: 12px;
}

.add-bot-btn {
    width: 80px;
    height: 26px;
    background-color: rgba(150, 150, 200, 0.2);
    border-radius: 4px;
    color: rgba(200, 200, 255, 0.8);
    font-size: 11px;
}

.add-bot-btn:hover {
    background-color: rgba(150, 150, 200, 0.4);
}

/* ============================================
   JOIN SECTION
   ============================================ */

.join-code-input {
    height: 90px;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 12px;
    border-width: 4px;
    border-color: rgba(212, 175, 55, 0.5);
    color: rgb(255, 255, 255);
    font-size: 40px;
    -unity-text-align: middle-center;
    letter-spacing: 8px;
}

.join-code-input:focus {
    border-color: rgb(212, 175, 55);
}

.join-btn {
    height: 36px;
    margin-top: 10px;
}

.quick-join-btn {
    height: 36px;
    background-color: rgba(100, 200, 100, 0.3);
    border-radius: 6px;
    color: rgb(150, 255, 150);
}

.quick-join-btn:hover {
    background-color: rgba(100, 200, 100, 0.5);
}

.tables-list-view {
    height: 100px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
}

.no-tables-label {
    color: rgba(255, 255, 255, 0.4);
    font-size: 12px;
    -unity-text-align: middle-center;
    padding: 20px;
}

/* ============================================
   ACTION BAR
   ============================================ */

.action-bar {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    padding: 15px 10px;
    background-color: rgba(0, 0, 0, 0.3);
    border-top-width: 1px;
    border-top-color: rgba(212, 175, 55, 0.2);
}

.action-bar Button {
    margin: 5px;
    flex-grow: 1;
}

.leave-btn {
    background-color: rgba(255, 80, 80, 0.3);
    border-radius: 6px;
    color: rgb(255, 150, 150);
}

.leave-btn:hover {
    background-color: rgba(255, 80, 80, 0.5);
}

.start-btn {
    width: 120px;
}

/* ============================================
   TABLE NAME
   ============================================ */

.table-name {
    color: rgb(255, 255, 255);
    font-size: 40px;
    -unity-font-style: bold;
}

/* ============================================
   INPUT LABEL
   ============================================ */

.input-label {
    color: rgba(255, 255, 255, 0.7);
    font-size: 12px;
    margin-top: 10px;
    margin-bottom: 5px;
}
