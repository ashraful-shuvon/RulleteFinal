<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="LobbyPanel.uss" />
    <ui:Style src="../Theme.uss" />
    <!-- Main Lobby/Invite Panel - Shown in-game -->
    <ui:VisualElement name="LobbyPanel" class="lobby-container">
        
        <!-- Header -->
        <ui:VisualElement name="Header" class="lobby-header">
            <ui:Label text="MULTIPLAYER" name="TitleLabel" class="title-text"/>
            <ui:Button text="✕" name="CloseButton" class="close-btn"/>
        </ui:VisualElement>
        
        <!-- Connection Status -->
        <ui:VisualElement name="ConnectionStatus" class="connection-status">
            <ui:Label text="● Connected" name="ConnectionLabel" class="status-connected"/>
            <ui:Label text="Ping: 45ms" name="PingLabel" class="ping-text"/>
        </ui:VisualElement>
        
        <!-- Main Content Area -->
        <ui:VisualElement name="ContentArea" class="content-area">
            
            <!-- Left Side: Room Info & Invite -->
            <ui:VisualElement name="RoomInfoSection" class="room-info-section">
                
                <!-- Current Room Info -->
                <ui:VisualElement name="CurrentRoom" class="current-room-card">
                    <ui:Label text="Current Table" class="section-label"/>
                    <ui:Label text="European Roulette" name="TableNameLabel" class="table-name"/>
                    
                    <!-- Table Settings -->
                    <ui:VisualElement name="TableSettings" class="table-settings">
                        <ui:Label text="Stakes:" class="setting-label"/>
                        <ui:DropdownField name="StakesDropdown" choices="Low,Medium,High" index="1" class="stakes-dropdown"/>
                        
                        <ui:Label text="Min Bet:" class="setting-label"/>
                        <ui:IntegerField name="MinBetInput" value="10" class="bet-input"/>
                        
                        <ui:Label text="Max Bet:" class="setting-label"/>
                        <ui:IntegerField name="MaxBetInput" value="1000" class="bet-input"/>
                        
                        <ui:Label text="Starting Balance:" class="setting-label"/>
                        <ui:IntegerField name="StartBalanceInput" value="3000" class="bet-input"/>
                    </ui:VisualElement>
                    
                    <!-- Room Code for Inviting -->
                    <ui:VisualElement name="RoomCodeSection" class="room-code-section">
                        <ui:Label text="Room Code:" class="room-code-label"/>
                        <ui:Label text="ABC123" name="RoomCodeText" class="room-code"/>
                        <ui:Button text="Copy" name="CopyCodeButton" class="copy-btn"/>
                    </ui:VisualElement>
                    
                    <!-- Invite Buttons -->
                    <ui:VisualElement name="InviteButtons" class="invite-buttons">
                        <ui:Button text="Invite Player" name="InviteButton" class="invite-btn primary-btn"/>
                        <ui:Button text="Share Room Code" name="ShareButton" class="share-btn"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                
                <!-- Players in Room -->
                <ui:VisualElement name="PlayersList" class="players-list-card">
                    <ui:Label text="Players in Table" class="section-label"/>
                    <ui:ListView name="PlayersListView" class="players-list-view"/>
                    
                    <!-- Player Count -->
                    <ui:VisualElement name="PlayerCount" class="player-count">
                        <ui:Label text="1/4 Players" name="PlayerCountLabel" class="player-count-text"/>
                        <ui:Button text="Add Bot" name="AddBotButton" class="add-bot-btn"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            
            <!-- Right Side: Join Other Room -->
            <ui:VisualElement name="JoinSection" class="join-section">
                
                <!-- Join by Code -->
                <ui:VisualElement name="JoinByCode" class="join-by-code-card">
                    <ui:Label text="Join a Table" class="section-label"/>
                    <ui:Label text="Enter Room Code:" class="input-label"/>
                    <ui:TextField name="JoinCodeInput" class="join-code-input" maxlength="6"/>
                    <ui:Button text="Join Table" name="JoinByCodeButton" class="join-btn primary-btn"/>
                </ui:VisualElement>
                
                <!-- Quick Join -->
                <ui:VisualElement name="QuickJoin" class="quick-join-card">
                    <ui:Label text="Quick Join" class="section-label"/>
                    <ui:Button text="Join Random Table" name="QuickJoinButton" class="quick-join-btn"/>
                </ui:VisualElement>
                
                <!-- Available Tables (Optional) -->
                <ui:VisualElement name="AvailableTables" class="available-tables-card">
                    <ui:Label text="Available Tables" class="section-label"/>
                    <ui:ListView name="AvailableTablesListView" class="tables-list-view"/>
                    <ui:Label text="No tables available" name="NoTablesLabel" class="no-tables-label"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        
        <!-- Bottom Action Bar -->
        <ui:VisualElement name="ActionBar" class="action-bar">
            <ui:Button text="Create Private Table" name="CreatePrivateButton" class="secondary-btn"/>
            <ui:Button text="Leave Table" name="LeaveButton" class="leave-btn"/>
            <ui:Button text="Start Game" name="StartGameButton" class="start-btn primary-btn"/>
        </ui:VisualElement>
        
    </ui:VisualElement>
</ui:UXML>
